# 复制为 .env.local 后填写；.env.local 已被 .gitignore（*.local）忽略，不会进仓库
# 上传逻辑在用户级技能 ~/.workbuddy/skills/release-uploader/，仓库 scripts/publish-release.mjs 只是转发
# 注意：USER/PASS 是 Cloudreve 里「连接与挂载 → WebDAV」创建的独立账号，
#       密码是系统生成的 WebDAV 专用密码，不是网页登录密码。
CLOUDREVE_URL=https://share.wondergarden.top
CLOUDREVE_USER=you@example.com
CLOUDREVE_PASS=your-webdav-password

# 远端根目录（相对 WebDAV 账号根），最终布局：<根>/AgentHub/<版本>/...
# 该账号根目录若已经是 my/Artifacts 就写 /
CLOUDREVE_BASE_DIR=/

# 只影响「打开目录」网页链接（WebDAV 根目录在 Cloudreve 里对应的路径）
CLOUDREVE_OPEN_BASE=my/Artifacts

# 1 = 上传时额外镜像到 AgentHub/latest/（固定链接指向最新版）
CLOUDREVE_LATEST=1

# 默认值，一般不用改
# CLOUDREVE_DAV_PATH=/dav
